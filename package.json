{
  "name": "glowing-palm-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "app": "node scripts/workspaces.mjs app",
    "build:web": "node scripts/workspaces.mjs build:web",
    "export:native": "node scripts/workspaces.mjs export:native",
    "typecheck": "tsc --noEmit",
    "check:codex": "node .github/scripts/validate-codex.mjs",
    "test:codex": "node --test --test-isolation=none .github/scripts/validate-codex.test.mjs",
    "test:core": "node scripts/workspaces.mjs test:core",
    "test:packages": "node scripts/test-packages.mjs",
    "test:config": "node --test --test-isolation=none config/app-config.test.cjs",
    "test": "npm run test:codex && npm run test:workspaces && npm run test:config && npm run test:packages",
    "check": "npm run check:codex && npm run typecheck && npm test",
    "test:workspaces": "node --test --test-isolation=none .github/scripts/workspaces.test.mjs",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "playwright": "1.56.1",
    "smol-toml": "1.9.1",
    "typescript": "~6.0.3",
    "yaml": "2.9.1"
  }
}
