# Public runtime configuration only. Leave unset until an app's provider is configured.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
# Set true only after verifying Enhanced Measurement is off for the web stream.
EXPO_PUBLIC_FIREBASE_ANALYTICS_STREAM_VERIFIED=false
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_WEB_BASE_PATH=
# Cloudflare Turnstile site key (public) for the customer phone-login CAPTCHA on web. Leave unset to skip the widget; set it only when Supabase CAPTCHA protection is on (#50).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
